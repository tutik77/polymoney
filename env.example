# --- Database ---
POSTGRES_USER=polymoney
POSTGRES_PASSWORD=polymoney
POSTGRES_DB=polymoney
DATABASE_URL=postgresql+asyncpg://polymoney:polymoney@5.129.232.183:5432/polymoney
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- HTTP / Client ---
POLYMARKET_BASE_URL=https://polymarkслуet.com
REQUEST_TIMEOUT_SECONDS=20

# Base rate limiting (starting point)
REQUESTS_PER_SECOND=2
MAX_CONCURRENCY=8

# Adaptive rate limiting (optional)
MIN_REQUESTS_PER_SECOND=1
MAX_REQUESTS_PER_SECOND=2.9
ADAPT_UP_SUCCESSES=20
ADAPT_DOWN_FACTOR=0.7
ADAPT_UP_FACTOR=1.1

# --- Leaderboard & pagination ---
LEADERBOARD_LIMIT=500
LEADERBOARD_PAGE_SIZE=50
CLOSED_POSITIONS_PAGE_SIZE=100
ACTIVE_POSITIONS_PAGE_SIZE=100

# Optional per-user caps (omit to fetch ALL)
# ACTIVE_MAX_TOTAL=200
# CLOSED_MAX_TOTAL=200

# Quick dry-run (smaller scope). Omit or set to 0 for full run.
# QUICK_TEST=0

# --- Ingest batching ---
INSERT_BATCH_SIZE=500

# --- Trading (CLOB) ---
# REQUIRED to trade: private key used for local EIP-712 signatures
# POLY_PRIVATE_KEY=0xYOUR_PRIVATE_KEY

POLYMARKET_CLOB_HOST=https://clob.polymarket.com
POLY_CHAIN_ID=137
# Optional funder/proxy wallet
# POLY_PROXY_WALLET=0xYourProxyOrFunderAddress


ACTIVITIES_POLL_INTERVAL_SECONDS=60
ACTIVITIES_PAGE_SIZE=100
ACTIVITIES_MAX_PAGES_PER_POLL=10

# --- Celery ---
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --- Elasticsearch ---
ELASTICSEARCH_ENABLED=false
ELASTICSEARCH_HOSTS=http://elasticsearch:9200


# --- Simulator dedup (LRU/TTL) ---
# Max number of recent activity signatures to keep per worker
SIM_DEDUPE_MAX_SIZE=20000
# TTL for dedup signatures in seconds (default: 6h)
SIM_DEDUPE_TTL_SECONDS=3600

# --- Automatic settlement ---
# How often to run settle_positions_all (in minutes)
SETTLEMENT_INTERVAL_MINUTES=480
# Force settle positions N days after end_date if not resolved
FORCE_SETTLE_AFTER_DAYS=3